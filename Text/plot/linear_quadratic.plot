# Настройка формата вывода (окно на Mac)
set terminal qt font "Consolas,22" size 1000,600


set xlabel "Точность"
set ylabel "Время выполнения (mcs)"

# Настройка сетки
set grid
set key left top  # Расположение легенды

# Определяем масштаб по оси X (чтобы метки были красивыми)
set xtics ( "1e-2" 1, "5e-3" 2, "1e-3" 3, "1e-4" 4, "1e-5" 5, "5e-6" 6, "1e-6" 7 )
set xrange [0.7:7.4]

# Вертикальный паддинг: расширяем автодиапазон по Y сверху и снизу,
# чтобы подписи числа узлов не вылезали за пределы.
# Аргументы: left, right, top, bottom.
set offsets graph 0, graph 0, graph 0.1, graph 0.1
# Метки оси Y начинаем с 0 с шагом 2000: нижний паддинг (диапазон уходит чуть
# ниже нуля) сохраняется, но отрицательная метка на оси не появляется.
set ytics 0, 2000

# Пояснение к числам над/под точками (что это за цифры).
# Размещаем в нижней части у правого края: легенда — слева сверху, кривые там ещё низко.
set label 1 "числа у точек — количество узлов сетки" \
    at graph 0.97, graph 0.06 right font "Consolas,14" tc rgb "#333333"

# Задаём явные цвета линий, чтобы подписи числа узлов совпадали по цвету
LIN_COLOR = "#1f77b4"
QUAD_COLOR = "#ff7f0e"

# Рисуем графики
# Первые два блока "-" — это сами кривые (x = индекс точности, y = время).
# Третий и четвёртый блоки "-" — те же точки, но со стилем "labels":
#   третий столбец данных = число узлов в сетке, которое подписывается у точки.
#   Linear подписывается над точкой (offset 0,1.2), Quadratic — под точкой
#   (offset 0,-1.2), чтобы числа не накладывались друг на друга.
plot "-" with linespoints lw 2 ps 1.5 lc rgb LIN_COLOR title "Linear", \
     "-" with linespoints lw 2 ps 1.5 lc rgb QUAD_COLOR title "Quadratic", \
     "-" using 1:2:3 with labels offset 0,1.2 font "Consolas,13" tc rgb LIN_COLOR notitle, \
     "-" using 1:2:3 with labels offset 0,-1.2 font "Consolas,13" tc rgb QUAD_COLOR notitle

# Кривая Linear (время выполнения)
1 241
2 416
3 984
4 2347
5 5746
6 6890
7 11990
e


# Кривая Quadratic (время выполнения)
