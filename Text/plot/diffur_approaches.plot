# Настройка формата вывода (окно на Mac)
set terminal qt font "Consolas,22" size 1000,600


set xlabel "Модельное время, t"
set ylabel "Время выполнения (mcs)"

# Настройка сетки
set grid
set key at graph -0.7, 0.97 left top

# Определяем масштаб по оси X (чтобы метки были красивыми)
set xtics ( 2, 5, 10, 20 )
set xrange [1.5:20.7]

# Вертикальный паддинг: расширяем автодиапазон по Y сверху и снизу,
# чтобы подписи числа узлов не вылезали за пределы.
# Аргументы: left, right, top, bottom.
set offsets graph 0, graph 0, graph 0.1, graph 0.1
# Метки оси Y начинаем с 0 с шагом 20000: нижний паддинг (диапазон уходит чуть
# ниже нуля) сохраняется, но отрицательная метка на оси не появляется.
set ytics 0, 400000

# Пояснение к числам над/под точками (что это за цифры).
# Размещаем в нижней части у правого края: легенда — слева сверху, кривые там ещё низко.
set label 1 "числа у точек — количество узлов сетки" \
    at graph 0.97, graph 0.06 right font "Consolas,14" tc rgb "#333333"

# Задаём явные цвета линий, чтобы подписи числа узлов совпадали по цвету
ITER_COLOR = "#1f77b4"
INTERVAL_COLOR = "#ff7f0e"

# Рисуем графики
# Первые два блока "-" — это сами кривые (x = модельное время, y = время выполнения).
# Третий и четвёртый блоки "-" — те же точки, но со стилем "labels":
#   третий столбец данных = число узлов, которое подписывается у точки.
#   Итеративный подход подписывается над точкой (offset 0,1.2), интервальный —
#   под точкой (offset 0,-1.2), чтобы числа не накладывались друг на друга.
plot "-" with linespoints lw 2 ps 1.5 lc rgb ITER_COLOR title "Итеративный подход", \
     "-" with linespoints lw 2 ps 1.5 lc rgb INTERVAL_COLOR title "Параметр t как интервальная неопределенность", \
     "-" using 1:2:3 with labels offset 0,-1.2 font "Consolas,13" tc rgb ITER_COLOR notitle, \
     "-" using 1:2:3 with labels offset 0,1.2 font "Consolas,13" tc rgb INTERVAL_COLOR notitle

# Кривая итеративного подхода (время выполнения)
2  1750
5  15275
10 121045
20 1068985
e


# Кривая интервального подхода (время выполнения)
2  3381
5  32711
10 266993
20 1811110
e


# Подписи числа узлов для итеративного подхода (x  y  nodes)
2  1750    204
5  15275   2259
10 121045  20846
20 1068985 207374
e


# Подписи числа узлов для интервального подхода (x  y  nodes)
2  3381  426
5  32711  2799
10 266993 18383
20 1811110 96388
e



# Пауза, чтобы окно не закрылось сразу (при запуске из терминала)
pause -1
